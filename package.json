{
  "name": "@iconsulting-dev/forgekit",
  "version": "1.10.11",
  "description": "Full-stack scaffolding CLI — Spring Boot or FastAPI backend, Angular frontend, Docker, CI/CD, and Claude Code config in one command.",
  "homepage": "https://salimomrani.github.io/forgekit",
  "type": "module",
  "bin": {
    "forgekit": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js && rm -rf dist/templates && cp -r src/templates dist/templates",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "release": "echo 'Use /forgekit.release — tag and push: git tag vX.Y.Z && git push origin vX.Y.Z'"
  },
  "keywords": [
    "cli",
    "scaffold",
    "spring-boot",
    "fastapi",
    "angular",
    "fullstack",
    "claude-code"
  ],
  "author": "Salim Omrani",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salimomrani/forgekit.git"
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.2.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "fs-extra": "^11.3.3",
    "handlebars": "^4.7.8",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.55.0",
    "vitest": "^4.0.18"
  }
}
