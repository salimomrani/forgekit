{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Paris",
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Group all non-major updates into one PR",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies"
    },
    {
      "description": "Auto-merge devDependencies minor/patch when CI passes",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Never auto-merge production dependencies",
      "matchDepTypes": ["dependencies"],
      "automerge": false
    },
    {
      "description": "Track next-auth on the beta dist-tag (v5 line)",
      "matchPackageNames": ["next-auth"],
      "followTag": "beta"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^src/versions\\.ts$/"],
      "matchStrings": [
        "\\w+:\\s*\"(?<currentValue>[^\"]+)\",\\s*//\\s*renovate:\\s*datasource=(?<datasource>npm|maven|packagist)\\s+depName=(?<depName>[^\\s]+)"
      ]
    }
  ]
}
