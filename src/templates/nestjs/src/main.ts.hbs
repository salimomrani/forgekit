import { NestFactory } from '@nestjs/core';
import { AppModule } from './app.module';{{#if openapi}}
import { DocumentBuilder, SwaggerModule } from '@nestjs/swagger';{{/if}}

async function bootstrap() {
  const app = await NestFactory.create(AppModule);{{#if openapi}}

  const config = new DocumentBuilder()
    .setTitle('{{name}}')
    .setDescription('{{description}}')
    .setVersion('1.0')
    .build();
  const document = SwaggerModule.createDocument(app, config);
  SwaggerModule.setup('api', app, document);{{/if}}

  await app.listen(process.env.PORT ?? 3000);
}
bootstrap();
