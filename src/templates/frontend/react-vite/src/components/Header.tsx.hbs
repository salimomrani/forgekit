import { Link } from 'react-router'
{{#if auth}}
import { useAuth } from '../hooks/useAuth'
{{/if}}

export function Header() {
{{#if auth}}
  const { isAuthenticated, logout } = useAuth()
{{/if}}

  return (
    <header className="bg-white border-b border-stone-200">
      <div className="max-w-7xl mx-auto px-6 h-14 flex items-center justify-between">
        <div className="flex items-center gap-8">
          <span className="font-mono text-sm font-bold tracking-tight text-stone-900">
            {{name}}
          </span>
          <nav>
            <Link
              to="/"
              className="text-sm text-stone-500 hover:text-stone-900 transition-colors"
            >
              Home
            </Link>
          </nav>
        </div>
{{#if auth}}
        <div>
          {isAuthenticated ? (
            <button
              onClick={logout}
              className="text-sm px-3 py-1.5 border border-stone-300 rounded text-stone-700 hover:border-stone-900 hover:text-stone-900 transition-colors"
            >
              Sign out
            </button>
          ) : (
            <a
              href="#"
              className="text-sm px-3 py-1.5 border border-stone-300 rounded text-stone-700 hover:border-stone-900 hover:text-stone-900 transition-colors"
            >
              Sign in
            </a>
          )}
        </div>
{{/if}}
      </div>
    </header>
  )
}
