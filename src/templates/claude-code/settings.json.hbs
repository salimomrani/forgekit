{
  "git": {
    "strategy": "{{gitStrategy}}"
  },
{{#if workflowSpeckit}}
  "speckit": {
    "tests": {{speckitTests}},
    "tdd": {{speckitTdd}},
    "test-types": "{{speckitTestTypes}}",
    "code-review": {{speckitCodeReview}},
    "security-review": "{{speckitSecurityReview}}",
    "verification": "{{speckitVerification}}",
    "plan-detail": "{{speckitPlanDetail}}",
    "skip-clarify": {{speckitSkipClarify}},
    "fast-mode": {{speckitFastMode}},
    "subagents": true
  },
{{/if}}
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./*.key)",
      "Read(./*.pem)",
      "Read(./*.p12)",
      "Read(./*secret*)",
      "Read(./*credential*)",
      "Read(./*token*)"
    ],
    "allow": [
{{#each allowedCommands}}
      "{{this}}",
{{/each}}
      "Bash(.specify/scripts/bash/*)",
      "Bash(git commit*)",
      "Bash(gh *)",
      "Skill(commit-commands:commit)",
      "Skill(commit-commands:commit:*)",
      "Skill(commit-commands:commit-push-pr)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:resources.anthropic.com)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{claudeDir}}/hooks/session-start.sh",
            "once": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{claudeDir}}/hooks/pre-bash.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Compaction: KEEP: file diffs, failing test errors, architecture decisions from constitution.md. DROP: passing test output, startup logs, install output, resolved discussions.'"
          }
        ]
      }
    ]
  }
}
