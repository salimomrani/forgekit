@import "tailwindcss";

:root {
  color-scheme: light;
  font-family: Inter, system-ui, sans-serif;
  background: #f7fafc;
  color: #0f172a;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background:
    radial-gradient(circle at top, rgba(14, 165, 233, 0.15), transparent 30%),
    linear-gradient(180deg, #f8fafc 0%, #eef2ff 100%);
}

button {
  cursor: pointer;
}
