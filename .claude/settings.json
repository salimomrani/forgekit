{
  "permissions": {
    "allow": [
      "Bash(node *)",
      "Bash(npm run *)",
      "Bash(npm install)",
      "Bash(npx *)",
      "Bash(gh *)",
      "Bash(git commit*)",
      "Bash(.specify/scripts/bash/*)",
      "Skill(commit-commands:commit)",
      "Skill(commit-commands:commit:*)",
      "Skill(commit-commands:commit-push-pr)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:resources.anthropic.com)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-start.sh",
            "once": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-bash.sh"
          }
        ]
      }
    ]
  }
}
